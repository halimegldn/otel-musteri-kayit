generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Musteri {
  id        Int         @id @default(autoincrement())
  ad        String
  soyad     String
  email     String      @unique
  telefon   String?
  adres     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  konaklama Konaklama[]
}

model Konaklama {
  id        String   @id @default(cuid())
  musteriId Int?
  musteri   Musteri? @relation(fields: [musteriId], references: [id])
  odaId     String?
  Oda       Oda?     @relation(fields: [odaId], references: [id])
  odeme     Odeme?
}

model Odeme {
  id          String    @id @default(cuid())
  tutar       Float
  konaklamaId String    @unique
  konaklama   Konaklama @relation(fields: [konaklamaId], references: [id])
}

model Oda {
  id        String      @id @default(cuid())
  numara    String
  konaklama Konaklama[]
}
